# Replit 設定：開發時按 Run 跑 next dev；Deploy 時先 build 再用 next start
modules = ["nodejs-24"]
run = "npm install && npm run dev -- -H 0.0.0.0 -p 5000"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm run start -- -H 0.0.0.0 -p ${PORT:-5000}"]

[[ports]]
localPort = 5000
externalPort = 80
