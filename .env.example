# ── Ragic（資料庫）──────────────────────────────
RAGIC_API_KEY=
# 賽事相簿表單編號（預設 7）
# RAGIC_ALBUM_SHEET=7

# ── LINE ───────────────────────────────────────
# LINE Login channel ID（LIFF App 所屬的 channel，用來驗證選手的 ID Token）
LIFF_CHANNEL_ID=
# LIFF ID（前端用，不填則用原本的 2010405599-yknWwXWq）
# NEXT_PUBLIC_LIFF_ID=
# Messaging API：報名成功推播、「解除綁定」webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# ── 後台（Google 登入）─────────────────────────
# 後台登入 cookie 簽章用，請填一長串亂碼
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 例：https://你的網域/admin/auth/callback（必須和 Google Cloud 登記的完全一樣）
GOOGLE_OAUTH_REDIRECT_URI=

# 本機測試用（正式環境不要設定，就算設了正式環境也會自動關閉）：
# AUTH_TEST_MODE=1 → 後台出現「本機測試登入」按鈕；沒填 RAGIC_API_KEY 時改用本機假資料（data/ragic-fake.json）
# NEXT_PUBLIC_LINE_TEST_MODE=1 → 前台在 localhost 略過 LINE 登入，以「測試選手」身分操作
# AUTH_TEST_MODE=1
# NEXT_PUBLIC_LINE_TEST_MODE=1
